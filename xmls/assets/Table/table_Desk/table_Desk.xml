<?xml version="1.0" ?>
<mujoco model="table_Desk">
  <compiler angle="radian" assetdir="assets" autolimits="true"/>

  <!-- 加载视觉和碰撞模型作为资源 -->
  <asset>
    <model name="visual_table_Desk" file="V_table_Desk.xml"/>
    <model name="collision_table_Desk" file="C_table_Desk.xml"/>
  </asset>

  <worldbody>
    <body name="table_Desk" pos="0 0 0">

      <!-- 附加碰撞模型 -->
      <body name="collision_anchor">
        <attach model="collision_table_Desk" prefix="collision_"/>
      </body>

      <!-- 附加视觉模型 -->
      <body name="visual_anchor">
        <attach model="visual_table_Desk" prefix="visual_"/>
      </body>
    </body>
  </worldbody>
</mujoco>
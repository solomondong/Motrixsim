<!-- hrb3q_demo.xml -->
<!-- Display HRB3Q-LC robot model -->
<mujoco model="HRB3Q-LC">
    <compiler angle="radian" meshdir="/opt/HRB3Q-LC/meshes"/>

    <visual>
        <map zfar="50"/>
        <global azimuth="90" elevation="45"/>
    </visual>

    <asset>
        <!-- Ground -->
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5" width="512" height="512"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" rgba="0.8 0.8 0.8 1"/>

        <!-- HRB3Q-LC Meshes -->
        <mesh name="Origin_base" file="Origin_base.STL"/>
        <mesh name="Waist" file="Waist.STL"/>
        <mesh name="Body" file="Body.STL"/>
        <mesh name="arml1" file="arml1.STL"/>
        <mesh name="arml2" file="arml2.STL"/>
        <mesh name="arml3" file="arml3.STL"/>
        <mesh name="arml4" file="arml4.STL"/>
        <mesh name="arml5" file="arml5.STL"/>
        <mesh name="arml6" file="arml6.STL"/>
        <mesh name="arml7" file="arml7.STL"/>
        <mesh name="armr1" file="armr1.STL"/>
        <mesh name="armr2" file="armr2.STL"/>
        <mesh name="armr3" file="armr3.STL"/>
        <mesh name="armr4" file="armr4.STL"/>
        <mesh name="armr5" file="armr5.STL"/>
        <mesh name="armr6" file="armr6.STL"/>
        <mesh name="armr7" file="armr7.STL"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="-1 0 -1" directional="true"/>
        
        <!-- Ground plane -->
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" rgba="0.8 0.8 0.8 1"/>

        <!-- HRB3Q-LC Robot (z=0.35 to keep chassis above floor) -->
        <body name="Origin_base" pos="0 0 0.35">
            <geom type="mesh" mesh="Origin_base" rgba="0.9 0.92 0.93 1"/>
            
            <body name="Waist" pos="-0.00019091 0 0">
                <joint name="Joint_Waist" type="slide" axis="1 0 0" range="0 0.5"/>
                <geom type="mesh" mesh="Waist" rgba="0.9 0.92 0.93 1"/>
                
                <body name="Body" pos="0 0 0.677">
                    <joint name="Joint_Body" type="hinge" axis="0 0 1"/>
                    <geom type="mesh" mesh="Body" rgba="0.9 0.92 0.93 1"/>
                    
                    <!-- Left Arm -->
                    <body name="arml1" pos="-0.1165 0 0.438" euler="1.5708 0 1.5708">
                        <joint name="Joint_l1" type="hinge" axis="0 0 -1"/>
                        <geom type="mesh" mesh="arml1" rgba="0.9 0.92 0.93 1"/>
                        
                        <body name="arml2" pos="0.0505 0 -0.074" euler="0 1.5708 0">
                            <joint name="Joint_l2" type="hinge" axis="0 0 1"/>
                            <geom type="mesh" mesh="arml2" rgba="0.9 0.92 0.93 1"/>
                            
                            <body name="arml3" pos="0 -0.1455 -0.0505" euler="-1.5708 0 3.1416">
                                <joint name="Joint_l3" type="hinge" axis="0 0 -1"/>
                                <geom type="mesh" mesh="arml3" rgba="0.9 0.92 0.93 1"/>
                                
                                <body name="arml4" pos="0.04 0 0.106" euler="-1.5708 0 -1.5708">
                                    <joint name="Joint_l4" type="hinge" axis="0 0 -1"/>
                                    <geom type="mesh" mesh="arml4" rgba="0.9 0.92 0.93 1"/>
                                    
                                    <body name="arml5" pos="0.144 0 -0.04" euler="0 1.5708 0">
                                        <joint name="Joint_l5" type="hinge" axis="0 0 -1"/>
                                        <geom type="mesh" mesh="arml5" rgba="0.9 0.92 0.93 1"/>
                                        
                                        <body name="arml6" pos="0 0.036 0.113" euler="-1.5708 0 0">
                                            <joint name="Joint_l6" type="hinge" axis="0 0 -1"/>
                                            <geom type="mesh" mesh="arml6" rgba="0.9 0.92 0.93 1"/>
                                            
                                            <body name="arml7" pos="0 -0.12 -0.036" euler="1.5708 0 0">
                                                <joint name="Joint_l7" type="hinge" axis="0 0 -1"/>
                                                <geom type="mesh" mesh="arml7" rgba="0.9 0.92 0.93 1"/>
                                            </body>
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                    
                    <!-- Right Arm -->
                    <body name="armr1" pos="0.1165 0 0.438" euler="1.5708 0 1.5708">
                        <joint name="Joint_r1" type="hinge" axis="0 0 1"/>
                        <geom type="mesh" mesh="armr1" rgba="0.9 0.92 0.93 1"/>
                        
                        <body name="armr2" pos="0.0505 0 0.074" euler="0 1.5708 0">
                            <joint name="Joint_r2" type="hinge" axis="0 0 1"/>
                            <geom type="mesh" mesh="armr2" rgba="0.9 0.92 0.93 1"/>
                            
                            <body name="armr3" pos="0 -0.1455 -0.0505" euler="-1.5708 0 -3.1416">
                                <joint name="Joint_r3" type="hinge" axis="0 0 -1"/>
                                <geom type="mesh" mesh="armr3" rgba="0.9 0.92 0.93 1"/>
                                
                                <body name="armr4" pos="-0.04 0 0.106" euler="1.5708 0 1.5708">
                                    <joint name="Joint_r4" type="hinge" axis="0 0 1"/>
                                    <geom type="mesh" mesh="armr4" rgba="0.9 0.92 0.93 1"/>
                                    
                                    <body name="armr5" pos="-0.144 0 0.04" euler="3.1416 1.5708 0">
                                        <joint name="Joint_r5" type="hinge" axis="0 0 -1"/>
                                        <geom type="mesh" mesh="armr5" rgba="0.9 0.92 0.93 1"/>
                                        
                                        <body name="armr6" pos="0 0.036 0.113" euler="-1.5708 0 0">
                                            <joint name="Joint_r6" type="hinge" axis="0 0 -1"/>
                                            <geom type="mesh" mesh="armr6" rgba="0.9 0.92 0.93 1"/>
                                            
                                            <body name="armr7" pos="0 -0.12 -0.036" euler="1.5708 0 0">
                                                <joint name="Joint_r7" type="hinge" axis="0 0 -1"/>
                                                <geom type="mesh" mesh="armr7" rgba="0.9 0.92 0.93 1"/>
                                            </body>
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <option gravity="0 0 -9.81" timestep="0.002"/>
</mujoco>
